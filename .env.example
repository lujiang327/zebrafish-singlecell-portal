# Host port exposed by the frontend Nginx container.
PORT=8080

# Path on the RHEL host to the large source h5ad file.
H5AD_PATH=./annotated_clustered_corrected_doubletRemoved_Zebrafishes.h5ad

# CORS is normally not used in production because Nginx proxies /api on the same origin.
# Set this if you intentionally expose the backend separately.
CORS_ORIGINS=http://localhost,http://127.0.0.1
